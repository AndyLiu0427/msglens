# Cloudflare Pages header rules.
#
# Header rules are ADDITIVE, not overriding — a more specific path sends a
# second header rather than replacing the first. For most headers that is
# merely redundant; for Content-Security-Policy it is a trap, because a
# browser given two policies enforces the intersection. A per-route rule
# adding cdn.paddle.com to /pricing therefore did nothing at all: the global
# policy still denied it, and the checkout was blocked on the live site with
# the page looking perfectly healthy until someone pressed Buy.
#
# So Paddle is allowed globally. This widens what the pages *may* do; it does
# not change what they *do*. Paddle.js is loaded from the Buy button and from
# nowhere else — the claim that the viewer talks to nothing is still true and
# still checkable in the Network tab, which is where it was ever verifiable.

/*
  # The app is fully static and parses files locally, so it needs no network
  # access of its own. Everything allowed below is ad tech or analytics:
  #   - fundingchoicesmessages.google.com is the CMP consent message
  #   - ep1/ep2.adtrafficquality.google is AdSense's invalid-traffic check;
  #     blocking it degrades ad serving and can look like invalid traffic
  #   - static.cloudflareinsights.com is Cloudflare Web Analytics, which
  #     Cloudflare injects automatically and which silently fails without this
  # If AdSense is not enabled, these hosts are simply unused.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.paddle.com https://static.hotjar.com https://script.hotjar.com https://pagead2.googlesyndication.com https://partner.googleadservices.com https://tpc.googlesyndication.com https://www.googletagservices.com https://adservice.google.com https://fundingchoicesmessages.google.com https://static.cloudflareinsights.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https:; font-src 'self' data:; connect-src 'self' https://*.paddle.com https://api.mixpanel.com https://*.hotjar.com https://*.hotjar.io wss://*.hotjar.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://csi.gstatic.com https://fundingchoicesmessages.google.com https://cloudflareinsights.com; frame-src 'self' https://*.paddle.com https://vars.hotjar.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://ep2.adtrafficquality.google https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # No feature this site offers needs any of these.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://buy.paddle.com" "https://sandbox-buy.paddle.com"), usb=(), interest-cohort=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Next emits generated Open Graph images with a content hash and no file
# extension. Without an explicit type a static host serves them as
# application/octet-stream and every social crawler rejects the card.
/opengraph-image-*
  Content-Type: image/png
  Cache-Control: public, max-age=604800

/*/opengraph-image-*
  Content-Type: image/png
  Cache-Control: public, max-age=604800

# The demo message must download rather than render as text.
/sample-message.msg
  Content-Type: application/vnd.ms-outlook
  Cache-Control: public, max-age=604800

# Fingerprinted build assets are safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/icon.svg
  Cache-Control: public, max-age=86400

/apple-icon.svg
  Cache-Control: public, max-age=86400
