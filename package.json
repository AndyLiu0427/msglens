{
  "name": "msg-viewer",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "assets": "tsx scripts/make-icons.mts && tsx scripts/make-sample-msg.mts",
    "verify:parse": "tsx scripts/verify-parse.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "db:migrate": "wrangler d1 execute msglens --remote --file db/migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 execute msglens --local --file db/migrations/0001_init.sql",
    "metrics": "tsx scripts/metrics.mts",
    "indexnow": "tsx scripts/indexnow.mts",
    "content-dates": "tsx scripts/content-dates.mts",
    "prebuild": "tsx scripts/content-dates.mts",
    "cli:build": "tsx cli/build.mts",
    "cli:bundle": "tsx cli/bundle.mts"
  },
  "dependencies": {
    "@kenjiuno/decompressrtf": "^0.1.4",
    "@kenjiuno/msgreader": "^1.28.0",
    "dompurify": "^3.4.13",
    "jszip": "^3.10.1",
    "next": "16.3.0",
    "postal-mime": "^2.7.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "cfb": "^1.2.2",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "happy-dom": "^20.11.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  },
  "packageManager": "pnpm@10.32.1"
}
